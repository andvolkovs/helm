# Copy to .env and adjust.

# --- Server ---
HELM_PORT=8787
# Interface to listen on. 127.0.0.1 keeps Helm off your LAN; other devices reach it through
# `tailscale serve`. Docker sets 0.0.0.0 inside the container (the published port stays local).
HELM_HOST=127.0.0.1
HELM_DB_PATH=./data/helm.db
# A copy of the database is saved once a day; the newest HELM_BACKUP_KEEP are kept (0 = off).
# Default folder: `backups` next to the database (in Docker, /data/backups in the volume).
# HELM_BACKUP_DIR=
HELM_BACKUP_KEEP=14
# Days of Activity history (who changed what, with Undo) to keep. 0 keeps all of it, and the
# database grows with every change. Tasks and the Done log are never removed, whatever this is.
HELM_HISTORY_KEEP_DAYS=0

# Owner login for the web app. Use something long.
HELM_OWNER_PASSWORD=change-me
# Random string used to sign session cookies (e.g. `openssl rand -hex 32`).
HELM_SESSION_SECRET=replace-with-random-hex
# Set to true when served over HTTPS (tailscale serve). Browsers still accept it on localhost.
HELM_COOKIE_SECURE=false
# Serve the built app (pnpm build) from the server, so one port runs everything.
# Relative to apps/server. Leave empty to serve the API only.
HELM_WEB_DIST=../web/dist

# --- Task rules ---
# Max tasks in progress at once. Starting one more demotes the oldest. 0 = unlimited.
HELM_IN_PROGRESS_LIMIT=1
# How deep subtasks may nest. 1 = subtasks cannot have subtasks.
HELM_MAX_SUBTASK_DEPTH=1

# --- AI providers ---
# Voice input and (later) the assistant. Leave the key empty to run without AI: voice then uses
# the browser's own speech recognition, and what you say becomes the task title as is.
# Providers: openai, none.
HELM_LLM_PROVIDER=openai
HELM_STT_PROVIDER=openai
OPENAI_API_KEY=
# Model that turns speech into task fields. HELM_LLM_REASONING_EFFORT applies to reasoning
# models (gpt-5 family, o-series) only; leave it empty for others such as gpt-4.1-mini.
HELM_LLM_MODEL=gpt-5-mini
HELM_LLM_REASONING_EFFORT=low
# Speech to text: gpt-4o-mini-transcribe, gpt-4o-transcribe or whisper-1.
HELM_STT_MODEL=gpt-4o-mini-transcribe
# Any OpenAI-compatible API (OpenRouter, Groq, Ollama, LM Studio). Empty = api.openai.com.
OPENAI_BASE_URL=

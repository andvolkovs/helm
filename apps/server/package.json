{
  "name": "@helm/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@helm/db": "workspace:*",
    "@helm/providers": "workspace:*",
    "@helm/shared": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "~12.11.1",
    "drizzle-orm": "^0.45.3",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.18",
    "ulidx": "^2.4.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
